DATABASE_URL=postgres://cathcy_app:REPLACE_PASSWORD@127.0.0.1:5432/cathcy_app
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Production Supabase: query URL uses transaction pooler 6543; realtime URL uses session pooler 5432.
DATABASE_SCHEMA=public
DATABASE_SSL=false

